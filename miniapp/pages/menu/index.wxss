@import "../../styles/common.wxss";

.menu-page {
  padding-bottom: 344rpx;
}

.search-panel {
  padding: 22rpx;
  margin-bottom: 18rpx;
}

.search-head {
  margin-bottom: 18rpx;
}

.menu-board {
  display: flex;
  min-height: 860rpx;
}

.category-rail {
  width: 176rpx;
  height: calc(100vh - 580rpx);
  margin-right: 18rpx;
  padding: 12rpx;
}

.category-list {
  display: flex;
  flex-direction: column;
}

.category-tab {
  display: flex;
  flex-direction: column;
  padding: 18rpx 12rpx;
  margin-bottom: 12rpx;
  border-radius: 24rpx;
  background-color: rgba(142, 92, 56, 0.06);
  color: #7d5641;
}

.category-tab.active {
  background: linear-gradient(135deg, #a84329, #d98a4a);
  color: #fff6eb;
}

.category-code {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  opacity: 0.72;
}

.category-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.dish-scroll {
  flex: 1;
  height: calc(100vh - 580rpx);
}

.dish-list {
  display: flex;
  flex-direction: column;
}

.dish-empty {
  padding: 60rpx 30rpx;
}

.dish-card {
  overflow: hidden;
  margin-bottom: 18rpx;
}

.dish-visual {
  height: 220rpx;
  background: linear-gradient(135deg, #f0cf8f, #e5b269);
}

.dish-visual.placeholder {
  padding: 24rpx;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.dish-art {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  padding: 12rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #6f2f19, #cb7d43);
  color: #fff5e7;
}

.dish-art-badge {
  align-self: flex-start;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 244, 228, 0.16);
  font-size: 20rpx;
  line-height: 42rpx;
}

.dish-art-name {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.dish-body {
  padding: 24rpx;
}

.dish-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.dish-title-box {
  flex: 1;
}

.dish-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #241513;
}

.dish-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #856758;
}

.stock-chip {
  flex-shrink: 0;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background-color: rgba(78, 151, 90, 0.12);
  color: #2f7a47;
  font-size: 22rpx;
  line-height: 52rpx;
}

.stock-chip.soldout {
  background-color: rgba(160, 64, 56, 0.12);
  color: #9f4037;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.dish-tag {
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background-color: rgba(141, 94, 59, 0.08);
  color: #7a5541;
  font-size: 22rpx;
  line-height: 44rpx;
}

.dish-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.dish-price-box {
  display: flex;
  align-items: baseline;
  color: #ab4528;
}

.dish-price-symbol {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.dish-price {
  font-size: 38rpx;
  font-weight: 700;
}

.dish-price-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #8b6d5d;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ad4629, #d78949);
  color: #fff6eb;
  font-size: 34rpx;
  font-weight: 700;
}

.stepper-button[disabled] {
  opacity: 0.38;
}

.stepper-button.subtle {
  background-color: rgba(125, 86, 65, 0.12);
  background-image: none;
  color: #77482f;
}

.stepper-count {
  min-width: 30rpx;
  margin: 0 10rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #33201b;
}

.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 132rpx;
  z-index: 28;
  display: flex;
  align-items: center;
  padding: 18rpx;
  border-radius: 32rpx;
  background-color: rgba(33, 17, 14, 0.94);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.2);
}

.cart-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.28);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 56rpx;
}

.cart-badge.visible {
  background: linear-gradient(135deg, #d56c3e, #f2b166);
  color: #3b1d12;
}

.cart-copy {
  flex: 1;
  margin-left: 16rpx;
  margin-right: 16rpx;
}

.cart-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff3e3;
}

.cart-summary {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 238, 223, 0.68);
}

.compact-button {
  flex: 0 0 142rpx;
  min-height: 84rpx;
  padding: 0 18rpx;
  margin-left: 12rpx;
}

.primary-compact {
  flex-basis: 152rpx;
}

.overlay-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 39;
  background-color: rgba(0, 0, 0, 0.32);
}

.cart-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  padding: 18rpx 24rpx 30rpx;
  border-radius: 36rpx 36rpx 0 0;
  background-color: #fbf3e9;
  box-shadow: 0 -14rpx 40rpx rgba(22, 12, 9, 0.14);
}

.sheet-handle {
  width: 96rpx;
  height: 10rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background-color: rgba(130, 87, 61, 0.22);
}

.cart-scroll {
  max-height: 420rpx;
  margin-bottom: 20rpx;
}

.cart-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(169, 120, 83, 0.12);
}

.cart-item-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-item-copy {
  flex: 1;
}

.cart-item-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2e1b18;
}

.cart-item-price {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9f5a34;
}

.cart-item-actions {
  display: flex;
  align-items: center;
}
