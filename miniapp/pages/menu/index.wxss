@import "../../styles/common.wxss";

.menu-page {
  padding-bottom: 344rpx;
}

.fee-notice {
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, rgba(255, 244, 228, 0.94), rgba(250, 230, 204, 0.92));
  border: 1rpx solid rgba(219, 180, 130, 0.15);
}

.fee-notice-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.fee-notice-kicker {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #a5734b;
}

.fee-notice-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #8a4329;
}

.fee-notice-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b4f42;
}

.search-panel {
  padding: 22rpx;
  margin-bottom: 18rpx;
}

.search-head {
  margin-bottom: 18rpx;
}

.menu-board {
  display: flex;
  min-height: 860rpx;
  gap: 18rpx;
}

.category-rail {
  width: 176rpx;
  height: calc(100vh - 580rpx);
  margin-right: 0;
  padding: 12rpx;
}

.category-list {
  display: flex;
  flex-direction: column;
}

.category-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 12rpx;
  margin-bottom: 12rpx;
  border-radius: 24rpx;
  background-color: rgba(142, 92, 56, 0.05);
  color: #6b4f42;
  border: 1rpx solid transparent;
  transition: all 0.25s ease;
}

.category-tab.active {
  background: linear-gradient(135deg, #a84329, #d98a4a);
  color: #fff6eb;
  box-shadow: 0 4rpx 12rpx rgba(181, 72, 42, 0.15);
  border-color: rgba(255, 255, 255, 0.1);
}

.category-code {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  opacity: 0.65;
}

.category-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.dish-scroll {
  flex: 1;
  height: calc(100vh - 580rpx);
}

.dish-list {
  display: flex;
  flex-direction: column;
}

.dish-empty {
  padding: 60rpx 30rpx;
}

.dish-card {
  overflow: hidden;
  margin-bottom: 18rpx;
}

.dish-visual {
  height: 220rpx;
  background: linear-gradient(135deg, #e8c88a, #d4a060);
  position: relative;
  overflow: hidden;
}

.dish-visual.placeholder {
  padding: 0;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.dish-art {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, #5a2414, #b07038);
  color: #fff5e7;
}

.dish-art-badge {
  align-self: flex-start;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 244, 228, 0.15);
  font-size: 20rpx;
  line-height: 42rpx;
}

.dish-art-name {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
}

.dish-body {
  padding: 24rpx;
}

.dish-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.dish-title-box {
  flex: 1;
}

.dish-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f120e;
}

.dish-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #9c7e6e;
}

.stock-chip {
  flex-shrink: 0;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background-color: rgba(47, 122, 71, 0.1);
  color: #2f7a47;
  font-size: 22rpx;
  line-height: 52rpx;
}

.stock-chip.soldout {
  background-color: rgba(176, 53, 42, 0.1);
  color: #b0352a;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.dish-tag {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background-color: rgba(141, 94, 59, 0.06);
  color: #6b4f42;
  font-size: 22rpx;
}

.dish-tag.food {
  background-color: rgba(219, 144, 80, 0.1);
  color: #a06030;
}

.portion-list {
  margin-top: 20rpx;
}

.portion-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  margin-top: 12rpx;
  border-radius: 22rpx;
  background-color: rgba(141, 94, 59, 0.04);
  border: 1rpx solid rgba(141, 94, 59, 0.04);
  transition: all 0.25s ease;
}

.portion-row.half {
  background-color: rgba(221, 146, 77, 0.08);
  border-color: rgba(221, 146, 77, 0.08);
}

.portion-copy {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
}

.portion-title-line {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
}

.portion-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f120e;
  white-space: nowrap;
}

.portion-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9c7e6e;
}

.portion-price-box {
  display: flex;
  align-items: baseline;
  color: #b5482a;
  font-weight: 800;
}

.dish-price-symbol {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.portion-price {
  font-size: 34rpx;
  font-weight: 800;
}

.dish-price-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #9c7e6e;
  font-weight: 500;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 0 0 auto;
  min-width: 166rpx;
  gap: 12rpx;
}

.stepper-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #b5482a, #d78949);
  color: #fff6eb;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.stepper-button::after {
  border: 0;
}

.stepper-button.disabled {
  opacity: 0.38;
}

.stepper-button.subtle {
  background-color: rgba(125, 86, 65, 0.1);
  background-image: none;
  color: #6b4f42;
}

.stepper-button:active {
  transform: scale(0.9);
}

.stepper-count {
  min-width: 26rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f120e;
}

.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 132rpx;
  z-index: 28;
  display: flex;
  align-items: center;
  padding: 18rpx;
  border-radius: 32rpx;
  background: rgba(33, 17, 14, 0.94);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.cart-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.25);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-badge.visible {
  background: linear-gradient(135deg, #d56c3e, #f2b166);
  color: #3b1d12;
}

.cart-copy {
  flex: 1;
  margin-left: 16rpx;
  margin-right: 16rpx;
}

.cart-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(255, 243, 227, 0.95);
}

.cart-summary {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 238, 223, 0.6);
}

.compact-button {
  flex: 0 0 142rpx;
  min-height: 84rpx;
  padding: 0 18rpx;
  margin-left: 12rpx;
}

.primary-compact {
  flex-basis: 152rpx;
}

.overlay-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 39;
  background-color: rgba(0, 0, 0, 0.32);
}

.cart-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  padding: 18rpx 24rpx 30rpx;
  border-radius: 36rpx 36rpx 0 0;
  background-color: #fbf3e9;
  box-shadow: 0 -14rpx 40rpx rgba(22, 12, 9, 0.14);
}

.sheet-handle {
  width: 96rpx;
  height: 10rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background-color: rgba(130, 87, 61, 0.18);
}

.cart-scroll {
  max-height: 420rpx;
  margin-bottom: 20rpx;
}

.cart-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(169, 120, 83, 0.08);
}

.cart-item:last-child {
  border-bottom: none;
}

.cart-item-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.cart-item-copy {
  flex: 1;
}

.cart-item-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f120e;
}

.cart-item-price {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #b5482a;
  font-weight: 700;
}

.cart-item-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9c7e6e;
}

.cart-item-actions {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  margin-left: 18rpx;
}
