<view class="page-shell menu-page">
  <view class="hero-shell menu-hero">
    <view class="hero-topline">
      <text class="hero-kicker">桌边点餐</text>
      <text class="hero-state">{{customerLabel}}</text>
    </view>
    <text class="hero-title">{{tableInfo.name || ('桌号 ' + tableId)}}</text>
    <text class="hero-subtitle">{{tableInfo.area || '堂食区域'}} · 现点现做 · 支持整份和半份</text>
    <view class="hero-badges">
      <text class="hero-badge">{{categories.length > 1 ? ((categories.length - 1) + ' 个分类') : '菜单已加载'}}</text>
      <text class="hero-badge">{{totalCount ? ('已选 ' + totalCount + ' 份') : '先挑几样招牌菜'}}</text>
    </view>
  </view>

  <view class="paper-card search-panel">
    <view class="section-head search-head">
      <view>
        <text class="section-eyebrow">MENU</text>
        <text class="section-title">按分类点餐</text>
      </view>
      <text class="section-meta">{{loading ? '正在加载菜单' : '下拉可刷新'}}</text>
    </view>
    <input
      class="copper-input"
      placeholder="搜索菜品名称"
      value="{{keyword}}"
      bindinput="handleKeywordInput"
    />
  </view>

  <view class="menu-board">
    <scroll-view scroll-y class="paper-card category-rail">
      <view class="category-list">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          wx:for-index="idx"
          class="category-tab {{activeCategoryId === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectCategory"
        >
          <text class="category-code">{{idx === 0 ? 'ALL' : (idx < 10 ? ('0' + idx) : idx)}}</text>
          <text class="category-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>

    <scroll-view scroll-y class="dish-scroll">
      <view wx:if="{{!loading && dishes.length === 0}}" class="paper-card empty-card dish-empty">
        <text class="empty-title">当前没有可展示的菜品</text>
        <text>换个分类或试试别的搜索关键词。</text>
      </view>

      <view wx:else class="dish-list">
        <view wx:for="{{dishes}}" wx:key="id" class="paper-card dish-card">
          <view class="dish-visual {{!item.image ? 'placeholder' : ''}}">
            <image wx:if="{{item.image}}" class="dish-image" src="{{item.image}}" mode="aspectFill"></image>
            <view wx:else class="dish-art">
              <text class="dish-art-badge">现点现做</text>
              <text class="dish-art-name">{{item.name}}</text>
            </view>
          </view>

          <view class="dish-body">
            <view class="dish-head">
              <view class="dish-title-box">
                <text class="dish-name">{{item.name}}</text>
                <text class="dish-desc">{{item.description || '精选食材，支持整份或半份灵活下单。'}}</text>
              </view>
              <text class="stock-chip {{item.stock > 0 ? '' : 'soldout'}}">{{item.stock > 0 ? ('余量 ' + item.stock) : '已售罄'}}</text>
            </view>

            <view class="dish-tags">
              <text class="dish-tag">{{item.image ? '门店实拍' : '铜锅推荐'}}</text>
              <text class="dish-tag">{{item.supportsHalf ? '支持半份' : '仅整份'}}</text>
            </view>

            <view class="portion-list">
              <view wx:for="{{item.portionOptions}}" wx:key="portionType" wx:for-item="option" class="portion-row {{option.portionType === 'HALF' ? 'half' : ''}}">
                <view class="portion-copy">
                  <view class="portion-title-line">
                    <text class="portion-label">{{option.label}}</text>
                    <view class="portion-price-box">
                      <text class="dish-price-symbol">¥</text>
                      <text class="portion-price">{{option.priceText}}</text>
                    </view>
                  </view>
                  <text class="portion-hint">{{option.portionType === 'HALF' ? '适合少量加菜或尝鲜' : '标准份量'}}</text>
                </view>
                <view class="stepper">
                  <view
                    wx:if="{{option.cartQty > 0}}"
                    class="stepper-button subtle"
                    data-id="{{item.id}}"
                    data-portion="{{option.portionType}}"
                    data-delta="-1"
                    bindtap="changeQty"
                  >
                    -
                  </view>
                  <text wx:if="{{option.cartQty > 0}}" class="stepper-count">{{option.cartQty}}</text>
                  <view
                    class="stepper-button {{option.addDisabled ? 'disabled' : ''}}"
                    data-id="{{item.id}}"
                    data-portion="{{option.portionType}}"
                    data-delta="1"
                    bindtap="changeQty"
                  >
                    +
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="cart-bar">
    <view class="cart-badge {{totalCount ? 'visible' : ''}}">{{totalCount || 0}}</view>
    <view class="cart-copy" bindtap="toggleCart">
      <text class="cart-title">{{totalCount ? ('已选 ' + totalCount + ' 份菜品') : '未选择菜品'}}</text>
      <text class="cart-summary">{{totalCount ? ('合计 ¥' + totalPrice + ' · 点击查看明细') : '先挑几样锅底、肉类或蔬菜'}}</text>
    </view>
    <button class="secondary-button compact-button" bindtap="goStatus">订单</button>
    <button class="primary-button compact-button primary-compact" loading="{{submitting}}" disabled="{{totalCount === 0}}" bindtap="submitOrder">
      提交
    </button>
  </view>

  <view wx:if="{{showCart}}" class="overlay-mask" bindtap="closeCart"></view>
  <view wx:if="{{showCart}}" class="cart-sheet">
    <view class="sheet-handle"></view>
    <view class="section-head">
      <view>
        <text class="section-eyebrow">CART</text>
        <text class="section-title">已选清单</text>
      </view>
      <text class="section-meta">{{totalCount}} 份 · ¥{{totalPrice}}</text>
    </view>

    <scroll-view scroll-y class="cart-scroll">
      <view wx:for="{{cartItems}}" wx:key="cartKey" class="cart-item">
        <view class="cart-item-main">
          <view class="cart-item-copy">
            <text class="cart-item-name">{{item.displayName}}</text>
            <text class="cart-item-meta">{{item.portionLabel}} · ¥{{item.priceText}} / 份</text>
            <text class="cart-item-price">¥{{item.subtotalText}}</text>
          </view>
          <view class="cart-item-actions">
            <view class="stepper-button subtle" data-id="{{item.dishId}}" data-portion="{{item.portionType}}" data-delta="-1" bindtap="changeQty">-</view>
            <text class="stepper-count">{{item.qty}}</text>
            <view class="stepper-button" data-id="{{item.dishId}}" data-portion="{{item.portionType}}" data-delta="1" bindtap="changeQty">+</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="field-block">
      <text class="field-label">备注</text>
      <textarea
        class="copper-textarea"
        maxlength="100"
        placeholder="例如：少辣、先上锅底、不放香菜"
        value="{{remark}}"
        bindinput="handleRemarkInput"
      ></textarea>
    </view>

    <button class="primary-button" loading="{{submitting}}" bindtap="submitOrder">确认下单</button>
  </view>

  <view class="bottom-nav">
    <view class="bottom-nav-track">
      <view class="bottom-nav-item" bindtap="goEntry">
        <text class="bottom-nav-mark">01</text>
        <text class="bottom-nav-label">首页</text>
      </view>
      <view class="bottom-nav-item active">
        <text class="bottom-nav-mark">02</text>
        <text class="bottom-nav-label">点餐</text>
      </view>
      <view class="bottom-nav-item" bindtap="goStatus">
        <text class="bottom-nav-mark">03</text>
        <text class="bottom-nav-label">订单</text>
      </view>
      <view class="bottom-nav-item" bindtap="goMine">
        <text class="bottom-nav-mark">04</text>
        <text class="bottom-nav-label">我的</text>
      </view>
    </view>
  </view>
</view>
