<view class="page-shell mine-page">
  <view class="hero-shell mine-hero">
    <view class="hero-topline">
      <text class="hero-kicker">MINE</text>
      <text class="hero-state">{{isLoggedIn ? '微信顾客' : '尚未登录'}}</text>
    </view>
    <text class="hero-title">{{isLoggedIn ? (info.name || '微信顾客') : '请先完成微信登录'}}</text>
    <text class="hero-subtitle">
      {{isLoggedIn ? (info.phoneBound ? maskedPhone : '绑定手机号后，可合并旧手机号顾客的历史订单与积分记录。') : '返回首页完成微信登录后，这里会展示历史订单、积分与消费记录。'}}
    </text>
    <view wx:if="{{isLoggedIn}}" class="hero-badges">
      <text class="hero-badge">{{info.phoneBound ? '已绑定手机号' : '待绑定手机号'}}</text>
      <text class="hero-badge">{{orders.length}} 笔订单</text>
    </view>
    <button wx:if="{{!isLoggedIn}}" class="chip-button hero-login-chip" bindtap="goEntry">回到首页登录</button>
  </view>

  <view wx:if="{{isLoggedIn}}" class="stats-grid">
    <view class="paper-card stats-card">
      <text class="stats-label">当前积分</text>
      <text class="stats-value">{{info.points || 0}}</text>
    </view>
    <view class="paper-card stats-card">
      <text class="stats-label">累计消费</text>
      <text class="stats-value">¥{{totalSpentText}}</text>
    </view>
    <view class="paper-card stats-card">
      <text class="stats-label">历史订单</text>
      <text class="stats-value">{{orders.length}}</text>
    </view>
  </view>

  <view wx:if="{{isLoggedIn && !info.phoneBound}}" class="paper-card bind-card">
    <view class="section-head bind-head">
      <view>
        <text class="section-eyebrow">BIND</text>
        <text class="section-title">绑定手机号</text>
      </view>
      <text class="section-meta">用于合并旧订单</text>
    </view>
    <text class="bind-copy">请输入之前点餐使用过的手机号，绑定成功后会把原顾客的订单、积分和累计消费并入当前微信身份。</text>
    <view class="field-block">
      <text class="field-label">手机号</text>
      <input
        class="copper-input"
        type="number"
        maxlength="11"
        placeholder="请输入 11 位手机号"
        value="{{bindingPhone}}"
        bindinput="handlePhoneInput"
      />
    </view>
    <view class="primary-button bind-button {{bindLoading ? 'disabled' : ''}}" bindtap="submitPhoneBinding">
      {{bindLoading ? '绑定中...' : '立即绑定并同步历史记录'}}
    </view>
  </view>

  <view wx:if="{{isLoggedIn && info.phoneBound}}" class="paper-card profile-note">
    当前手机号已与微信身份绑定。之后在小程序内查看的历史订单、积分和累计消费，都会以当前微信顾客为准。
  </view>

  <view wx:if="{{!isLoggedIn}}" class="paper-card empty-card mine-empty">
    <text class="empty-title">当前未建立微信登录态</text>
    <text>返回首页重新完成微信登录后，这里会显示积分、消费与历史记录。</text>
  </view>

  <view wx:elif="{{isLoggedIn}}" class="paper-card record-panel">
    <view class="section-head panel-head">
      <view>
        <text class="section-eyebrow">RECORDS</text>
        <text class="section-title">我的记录</text>
      </view>
      <text class="section-meta">下拉可刷新</text>
    </view>

    <view class="tab-row">
      <view class="tab-pill {{activeTab === 'orders' ? 'active' : ''}}" data-tab="orders" bindtap="switchTab">
        消费记录
      </view>
      <view class="tab-pill {{activeTab === 'points' ? 'active' : ''}}" data-tab="points" bindtap="switchTab">
        积分明细
      </view>
    </view>

    <view wx:if="{{activeTab === 'orders'}}">
      <view wx:if="{{!orders.length}}" class="inner-empty">
        暂无消费记录
      </view>
      <view wx:for="{{orders}}" wx:key="id" class="record-item">
        <view class="record-head">
          <view class="record-main">
            <text class="record-title">{{item.orderNo}}</text>
            <text class="record-time">{{item.createTimeText}}</text>
          </view>
          <view class="record-side">
            <text class="record-price">¥{{item.totalAmountText}}</text>
            <text class="record-tag {{item.statusClass}}">{{item.statusText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{activeTab === 'points'}}">
      <view wx:if="{{!pointsRecords.length}}" class="inner-empty">
        暂无积分明细
      </view>
      <view wx:for="{{pointsRecords}}" wx:key="id" class="record-item">
        <view class="record-head">
          <view class="record-main">
            <text class="record-title">{{item.remark || '积分变动'}}</text>
            <text class="record-time">{{item.createTimeText}}</text>
          </view>
          <view class="record-side">
            <text class="record-points {{item.points > 0 ? 'plus' : 'minus'}}">{{item.pointsText}}</text>
            <text class="record-tag neutral">{{item.points > 0 ? '入账' : '扣减'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="bottom-nav-track">
      <view class="bottom-nav-item" bindtap="goEntry">
        <text class="bottom-nav-mark">01</text>
        <text class="bottom-nav-label">首页</text>
      </view>
      <view class="bottom-nav-item" bindtap="goMenu">
        <text class="bottom-nav-mark">02</text>
        <text class="bottom-nav-label">点餐</text>
      </view>
      <view class="bottom-nav-item" bindtap="goStatus">
        <text class="bottom-nav-mark">03</text>
        <text class="bottom-nav-label">订单</text>
      </view>
      <view class="bottom-nav-item active">
        <text class="bottom-nav-mark">04</text>
        <text class="bottom-nav-label">我的</text>
      </view>
    </view>
  </view>
</view>
