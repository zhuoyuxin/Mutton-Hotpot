@import "../../styles/common.wxss";

.mine-page {
  padding-bottom: 170rpx;
}

.hero-login-chip {
  margin-top: 24rpx;
  align-self: flex-start;
}

.stats-grid {
  display: flex;
  margin-bottom: 18rpx;
}

.stats-card {
  flex: 1;
  padding: 24rpx 20rpx;
  margin-right: 16rpx;
}

.stats-card:last-child {
  margin-right: 0;
}

.stats-label {
  display: block;
  font-size: 22rpx;
  color: #8b6d5d;
}

.stats-value {
  display: block;
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #281815;
}

.profile-note {
  margin-bottom: 18rpx;
  padding: 24rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7f6154;
}

.bind-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.bind-head {
  margin-bottom: 14rpx;
}

.bind-copy {
  display: block;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7f6154;
}

.bind-button {
  margin-top: 20rpx;
}

.bind-button.disabled {
  opacity: 0.45;
}

.mine-empty {
  padding: 60rpx 32rpx;
}

.record-panel {
  padding: 22rpx 24rpx;
}

.panel-head {
  margin-bottom: 18rpx;
}

.tab-row {
  display: flex;
  margin-bottom: 16rpx;
}

.tab-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 26rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background-color: rgba(140, 95, 62, 0.08);
  color: #7f5944;
  font-size: 24rpx;
  font-weight: 600;
}

.tab-pill:last-child {
  margin-right: 0;
}

.tab-pill.active {
  background: linear-gradient(135deg, #a84329, #d98a4a);
  color: #fff5ea;
}

.inner-empty {
  padding: 46rpx 0;
  text-align: center;
  color: #8a6d5f;
  font-size: 24rpx;
}

.record-item + .record-item {
  border-top: 1rpx solid rgba(164, 119, 87, 0.12);
}

.record-item {
  padding: 20rpx 0;
}

.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.record-main {
  flex: 1;
}

.record-title {
  display: block;
  font-size: 28rpx;
  color: #2e1c19;
  word-break: break-all;
}

.record-time {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8b6d5d;
}

.record-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 18rpx;
}

.record-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #ab4528;
}

.record-points {
  font-size: 26rpx;
  font-weight: 700;
}

.record-points.plus {
  color: #2f7a47;
}

.record-points.minus {
  color: #9f4037;
}

.record-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.record-tag.processing {
  background-color: rgba(235, 165, 90, 0.18);
  color: #9d581e;
}

.record-tag.warning {
  background-color: rgba(233, 144, 56, 0.16);
  color: #9d541a;
}

.record-tag.success {
  background-color: rgba(91, 170, 116, 0.16);
  color: #2f7a47;
}

.record-tag.muted {
  background-color: rgba(126, 101, 92, 0.12);
  color: #7a6358;
}

.record-tag.neutral {
  background-color: rgba(140, 95, 62, 0.1);
  color: #7f5944;
}
