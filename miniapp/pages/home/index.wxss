@import "../../styles/common.wxss";

.entry-page {
  padding-top: 22rpx;
}

.hero-entry {
  margin-bottom: 22rpx;
  padding: 28rpx 28rpx 30rpx;
  border-radius: 32rpx;
}

.hero-entry .hero-topline {
  margin-bottom: 18rpx;
}

.hero-entry .hero-title {
  font-size: 38rpx;
  line-height: 1.22;
}

.hero-entry .hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.hero-entry .hero-badges {
  margin-top: 20rpx;
}

.hero-entry .hero-badge {
  min-height: 50rpx;
  padding: 0 18rpx;
  line-height: 50rpx;
}

.entry-card {
  padding: 30rpx;
  border-radius: 30rpx;
}

.entry-card .section-head {
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.entry-card .section-title {
  font-size: 32rpx;
  line-height: 1.3;
}

.entry-card .section-meta {
  padding-top: 50rpx;
  flex-shrink: 0;
}

.scan-button {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
  align-self: stretch;
  min-height: 132rpx;
  margin: 0;
  padding: 26rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #42170f 0%, #7c2f18 48%, #cf7d38 100%);
  color: #fff4e8;
  box-shadow: 0 16rpx 30rpx rgba(103, 47, 24, 0.18);
  position: relative;
  overflow: hidden;
}

.scan-button::before {
  content: '';
  position: absolute;
  top: -90rpx;
  right: -56rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(232, 168, 92, 0.18) 0%, transparent 68%);
  border-radius: 50%;
}

.scan-button::after {
  border: 0;
}

.scan-button:active {
  transform: scale(0.98);
}

.scan-button-title {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
  white-space: nowrap;
  position: relative;
  z-index: 1;
}

.scan-button-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: rgba(255, 244, 230, 0.86);
  position: relative;
  z-index: 1;
}

.table-panel {
  margin-top: 28rpx;
  padding: 26rpx 30rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, rgba(252, 245, 237, 0.98), rgba(255, 255, 255, 0.82));
  border: 1rpx solid rgba(191, 118, 72, 0.08);
  box-shadow: 0 12rpx 32rpx rgba(88, 49, 26, 0.06);
}

.table-panel-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #9c7e6e;
  letter-spacing: 1rpx;
}

.table-panel-main {
  display: flex;
  flex-direction: column;
}

.table-panel-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f120e;
}

.table-panel-tip {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2d1b18;
}

.table-panel-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #9c7e6e;
}

.table-panel-empty {
  display: flex;
  flex-direction: column;
}

.identity-card,
.feature-card {
  padding: 30rpx;
  border-radius: 30rpx;
}

.identity-panel {
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background-color: rgba(145, 93, 61, 0.04);
  border: 1rpx solid rgba(145, 93, 61, 0.08);
}

.identity-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
}

.identity-label {
  font-size: 22rpx;
  color: #9c7e6e;
  letter-spacing: 1rpx;
}

.identity-main {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f120e;
}

.identity-note {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #9c7e6e;
}

.identity-error {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #b0352a;
}

.identity-button {
  width: 100%;
  margin-top: 12rpx;
}

.feature-head {
  margin-bottom: 8rpx;
}

.capability-list {
  margin: 4rpx 0 0;
}

.capability-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(170, 124, 76, 0.08);
}

.capability-item:last-child {
  border-bottom: none;
}

.capability-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(184, 77, 44, 0.1), rgba(219, 144, 80, 0.1));
  color: #b5482a;
  font-size: 20rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.capability-copy {
  flex: 1;
}

.capability-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f120e;
}

.capability-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #9c7e6e;
}
