.entry-card {
  padding: 30rpx;
}

.table-banner {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(191, 118, 72, 0.1), rgba(255, 255, 255, 0.62));
}

.table-banner-label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  color: #8a6450;
  letter-spacing: 2rpx;
}

.table-banner-main {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.table-banner-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #2a1714;
}

.table-banner-area {
  font-size: 24rpx;
  color: #8a6450;
}

.table-banner-empty {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  font-size: 24rpx;
  color: #86685b;
  line-height: 1.6;
}

.entry-tips {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin: 28rpx 0 30rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #8c7063;
}

.wechat-panel {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(145, 93, 61, 0.08);
}

.wechat-label {
  font-size: 22rpx;
  color: #8a6450;
  letter-spacing: 2rpx;
}

.wechat-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #281815;
}

.wechat-error {
  font-size: 22rpx;
  line-height: 1.6;
  color: #a34337;
}

.retry-button {
  width: 100%;
  margin-top: 8rpx;
}
