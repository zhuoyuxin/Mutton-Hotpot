@import "../../styles/common.wxss";

.status-page {
  padding-bottom: 170rpx;
}

.summary-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.summary-card {
  flex: 1;
  padding: 24rpx 20rpx;
  margin-right: 0;
  text-align: center;
}

.summary-card:last-child {
  margin-right: 0;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: #9c7e6e;
}

.summary-value {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #1f120e;
}

.status-empty {
  padding: 60rpx 32rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
}

.order-card {
  padding: 26rpx;
  margin-bottom: 18rpx;
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.order-copy {
  flex: 1;
}

.order-no {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f120e;
  word-break: break-all;
}

.order-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9c7e6e;
}

.order-status,
.item-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.item-status {
  min-height: 48rpx;
  padding: 0 16rpx;
  font-size: 20rpx;
}

.processing {
  background-color: rgba(199, 122, 30, 0.1);
  color: #c77a1e;
}

.warning {
  background-color: rgba(233, 144, 56, 0.1);
  color: #c77a1e;
}

.success {
  background-color: rgba(47, 122, 71, 0.1);
  color: #2f7a47;
}

.danger {
  background-color: rgba(176, 53, 42, 0.1);
  color: #b0352a;
}

.muted {
  background-color: rgba(126, 101, 92, 0.1);
  color: #9c7e6e;
}

.dish-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(164, 119, 87, 0.08);
}

.dish-row-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dish-row-name {
  flex: 1;
  font-size: 26rpx;
  color: #1f120e;
}

.dish-row-qty {
  font-size: 24rpx;
  color: #9c7e6e;
}
