.status-page {
  padding-bottom: calc(206rpx + env(safe-area-inset-bottom));
}

.hero-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 22rpx;
  font-size: 22rpx;
  color: rgba(255, 244, 226, 0.78);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.summary-card {
  padding: 24rpx 20rpx;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: #8d705e;
}

.summary-value {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #251614;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-card {
  padding: 26rpx;
}

.order-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.order-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: 700;
  color: #281815;
  word-break: break-all;
}

.order-time {
  font-size: 22rpx;
  color: #8b6b5b;
}

.dish-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(164, 119, 87, 0.12);
}

.dish-row-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dish-row-name {
  flex: 1;
  font-size: 26rpx;
  color: #38231d;
}

.dish-row-qty {
  font-size: 24rpx;
  color: #997768;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge.small {
  min-height: 48rpx;
  padding: 0 16rpx;
  font-size: 20rpx;
}

.badge.processing {
  background: rgba(235, 165, 90, 0.18);
  color: #9d581e;
}

.badge.warning {
  background: rgba(233, 144, 56, 0.16);
  color: #9d541a;
}

.badge.success {
  background: rgba(91, 170, 116, 0.16);
  color: #2f7a47;
}

.badge.danger {
  background: rgba(212, 94, 80, 0.14);
  color: #9f4037;
}

.badge.muted {
  background: rgba(126, 101, 92, 0.12);
  color: #7a6358;
}
