@import "../../styles/common.wxss";

.status-page {
  padding-bottom: 170rpx;
}

.summary-grid {
  display: flex;
  margin-bottom: 22rpx;
}

.summary-card {
  flex: 1;
  padding: 24rpx 20rpx;
  margin-right: 16rpx;
}

.summary-card:last-child {
  margin-right: 0;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: #8d705e;
}

.summary-value {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #251614;
}

.status-empty {
  padding: 60rpx 32rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
}

.order-card {
  padding: 26rpx;
  margin-bottom: 18rpx;
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.order-copy {
  flex: 1;
}

.order-no {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #281815;
  word-break: break-all;
}

.order-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b6b5b;
}

.order-status,
.item-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.item-status {
  min-height: 48rpx;
  padding: 0 16rpx;
  font-size: 20rpx;
}

.processing {
  background-color: rgba(235, 165, 90, 0.18);
  color: #9d581e;
}

.warning {
  background-color: rgba(233, 144, 56, 0.16);
  color: #9d541a;
}

.success {
  background-color: rgba(91, 170, 116, 0.16);
  color: #2f7a47;
}

.danger {
  background-color: rgba(212, 94, 80, 0.14);
  color: #9f4037;
}

.muted {
  background-color: rgba(126, 101, 92, 0.12);
  color: #7a6358;
}

.dish-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(164, 119, 87, 0.12);
}

.dish-row-main {
  flex: 1;
  display: flex;
  align-items: center;
}

.dish-row-name {
  flex: 1;
  font-size: 26rpx;
  color: #38231d;
}

.dish-row-qty {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #997768;
}
