<view class="page-shell status-page">
  <view class="hero-shell status-hero">
    <view class="hero-topline">
      <text class="hero-kicker">后厨进度</text>
      <text class="hero-state">每 10 秒自动刷新</text>
    </view>
    <text class="hero-title">{{tableInfo.name || ('桌号 ' + tableId)}}</text>
    <text class="hero-subtitle">{{tableInfo.area || '堂食区域'}} · 最后刷新 {{lastUpdatedAt || '--'}}</text>
    <view class="hero-badges">
      <text class="hero-badge">订单 {{totalOrders}}</text>
      <text class="hero-badge">待上菜 {{pendingItems}}</text>
      <text class="hero-badge">已上菜 {{servedItems}}</text>
    </view>
  </view>

  <view class="summary-grid">
    <view class="paper-card summary-card">
      <text class="summary-label">当前订单</text>
      <text class="summary-value">{{totalOrders}}</text>
    </view>
    <view class="paper-card summary-card">
      <text class="summary-label">待上菜</text>
      <text class="summary-value">{{pendingItems}}</text>
    </view>
    <view class="paper-card summary-card">
      <text class="summary-label">已上菜</text>
      <text class="summary-value">{{servedItems}}</text>
    </view>
  </view>

  <view wx:if="{{!orders.length}}" class="paper-card empty-card status-empty">
    <text class="empty-title">当前还没有订单</text>
    <text>回到点餐页继续加菜后，这里会自动更新上菜状态。</text>
  </view>

  <view wx:else class="order-list">
    <view wx:for="{{orders}}" wx:key="id" class="paper-card order-card">
      <view class="order-head">
        <view class="order-copy">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-time">{{item.createTimeText}}</text>
        </view>
        <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>

      <view wx:for="{{item.items}}" wx:key="id" class="dish-row">
        <view class="dish-row-main">
          <text class="dish-row-name">{{item.dishName}}</text>
          <text class="dish-row-qty">x{{item.quantity}}</text>
        </view>
        <text class="item-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="bottom-nav-track">
      <view class="bottom-nav-item" bindtap="goEntry">
        <text class="bottom-nav-mark">01</text>
        <text class="bottom-nav-label">首页</text>
      </view>
      <view class="bottom-nav-item" bindtap="goMenu">
        <text class="bottom-nav-mark">02</text>
        <text class="bottom-nav-label">点餐</text>
      </view>
      <view class="bottom-nav-item active">
        <text class="bottom-nav-mark">03</text>
        <text class="bottom-nav-label">订单</text>
      </view>
      <view class="bottom-nav-item" bindtap="goMine">
        <text class="bottom-nav-mark">04</text>
        <text class="bottom-nav-label">我的</text>
      </view>
    </view>
  </view>
</view>
