page {
  min-height: 100%;
  background-color: #f5ede2;
  color: #1f120e;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea,
image,
scroll-view {
  box-sizing: border-box;
}

/* ========== 页面壳 ========== */
.page-shell {
  width: 100%;
  min-height: 100vh;
  padding: 24rpx 24rpx 170rpx;
  background: linear-gradient(180deg, #faf5ed 0%, #f0e5d6 100%);
  overflow-x: hidden;
}

/* ========== HERO ========== */
.hero-shell {
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #3a1810 0%, #7a3119 40%, #c87a3a 100%);
  color: #fff5e6;
  box-shadow: 0 4rpx 12rpx rgba(60, 30, 14, 0.08), 0 16rpx 48rpx rgba(60, 30, 14, 0.12);
  position: relative;
  overflow: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.hero-shell::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(232, 168, 92, 0.2) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  position: relative;
  z-index: 1;
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 241, 214, 0.65);
}

.hero-state {
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 245, 230, 0.12);
  border: 1rpx solid rgba(255, 236, 214, 0.15);
  font-size: 20rpx;
  line-height: 48rpx;
  color: rgba(255, 243, 223, 0.9);
}

.hero-title {
  display: block;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.15;
  position: relative;
  z-index: 1;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 244, 226, 0.78);
  position: relative;
  z-index: 1;
}

.hero-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
  position: relative;
  z-index: 1;
}

.hero-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 247, 233, 0.1);
  border: 1rpx solid rgba(255, 241, 214, 0.12);
  font-size: 22rpx;
  line-height: 50rpx;
  color: rgba(255, 242, 224, 0.88);
}

/* ========== 卡片 ========== */
.paper-card {
  border-radius: 30rpx;
  background-color: #fffbf5;
  box-shadow: 0 2rpx 8rpx rgba(60, 30, 14, 0.08), 0 8rpx 28rpx rgba(60, 30, 14, 0.1);
  margin-bottom: 18rpx;
  overflow: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

/* ========== 区块标题 ========== */
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-eyebrow {
  display: block;
  margin-bottom: 10rpx;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #9c7e6e;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f120e;
}

.section-meta {
  font-size: 22rpx;
  color: #9c7e6e;
}

/* ========== 按钮 ========== */
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #b5482a, #db9050);
  color: #fff4e8;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(181, 72, 42, 0.25);
  transition: all 0.25s ease;
}

.primary-button::after {
  border: 0;
}

.primary-button[disabled] {
  opacity: 0.4;
  box-shadow: none;
}

.primary-button:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(181, 72, 42, 0.2);
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(170, 124, 76, 0.2);
  background-color: rgba(255, 255, 255, 0.85);
  color: #7f4b30;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.25s ease;
}

.secondary-button::after {
  border: 0;
}

.secondary-button:active {
  background-color: rgba(255, 255, 255, 1);
  transform: scale(0.97);
}

.chip-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 245, 230, 0.16);
  border: 1rpx solid rgba(255, 236, 214, 0.18);
  color: #fff2de;
  font-size: 24rpx;
}

.chip-button::after {
  border: 0;
}

/* ========== 表单输入 ========== */
.copper-input,
.copper-textarea {
  width: 100%;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(170, 124, 76, 0.15);
  border-radius: 24rpx;
  background-color: #ffffff;
  font-size: 28rpx;
  color: #1f120e;
  transition: all 0.25s ease;
}

.copper-input:focus,
.copper-textarea:focus {
  border-color: rgba(181, 72, 42, 0.35);
}

.copper-textarea {
  min-height: 164rpx;
  line-height: 1.7;
}

.field-block + .field-block {
  margin-top: 20rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #6b4f42;
  font-weight: 500;
}

/* ========== 底部导航 ========== */
.bottom-nav {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  z-index: 26;
  padding: 10rpx;
  border-radius: 28rpx;
  background-color: rgba(255, 251, 245, 0.98);
  box-shadow: 0 -4rpx 20rpx rgba(60, 30, 14, 0.08);
  border: 1rpx solid rgba(170, 124, 76, 0.06);
}

.bottom-nav-track {
  display: flex;
}

.bottom-nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  border-radius: 20rpx;
  color: #9c7e6e;
  transition: all 0.25s ease;
}

.bottom-nav-item::after {
  border: 0;
}

.bottom-nav-item.active {
  background: linear-gradient(135deg, #b5482a, #d8934f);
  color: #fff6e8;
  box-shadow: 0 4rpx 12rpx rgba(181, 72, 42, 0.2);
}

.bottom-nav-mark {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  opacity: 0.65;
}

.bottom-nav-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

/* ========== 空状态 ========== */
.empty-card {
  padding: 46rpx 32rpx;
  text-align: center;
  border-radius: 28rpx;
  background-color: rgba(255, 255, 255, 0.92);
  color: #9c7e6e;
}

.empty-card .empty-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #4d3028;
}

/* ========== 状态徽章 ========== */
.status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-chip.processing {
  background-color: rgba(199, 122, 30, 0.1);
  color: #c77a1e;
}

.status-chip.success {
  background-color: rgba(47, 122, 71, 0.1);
  color: #2f7a47;
}

.status-chip.danger {
  background-color: rgba(176, 53, 42, 0.1);
  color: #b0352a;
}

.status-chip.muted {
  background-color: rgba(126, 101, 92, 0.1);
  color: #9c7e6e;
}

/* ========== 标签芯片 ========== */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.chip-stock {
  background-color: rgba(47, 122, 71, 0.1);
  color: #2f7a47;
}

.chip-stock.soldout {
  background-color: rgba(176, 53, 42, 0.1);
  color: #b0352a;
}

.chip-tag {
  background-color: rgba(141, 94, 59, 0.06);
  color: #6b4f42;
}

.chip-tag.food {
  background-color: rgba(219, 144, 80, 0.1);
  color: #a06030;
}

/* ========== 分隔线 ========== */
.divider {
  height: 1rpx;
  background: rgba(170, 124, 76, 0.08);
  margin: 12rpx 0;
}
