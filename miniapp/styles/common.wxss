page {
  min-height: 100%;
  background-color: #f6efe5;
  color: #241513;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea,
image,
scroll-view {
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 170rpx;
  background:
    linear-gradient(180deg, #f8f1e7 0%, #f2e6d8 100%);
}

.hero-shell {
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #442018 0%, #8b3e24 54%, #d48a4a 100%);
  color: #fff5e5;
  box-shadow: 0 18rpx 42rpx rgba(92, 42, 22, 0.22);
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 241, 214, 0.76);
}

.hero-state {
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 245, 230, 0.16);
  border: 1rpx solid rgba(255, 236, 214, 0.18);
  font-size: 20rpx;
  line-height: 48rpx;
  color: #fff3df;
}

.hero-title {
  display: block;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.18;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 244, 226, 0.88);
}

.hero-badges {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.hero-badge {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  min-height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 247, 233, 0.14);
  border: 1rpx solid rgba(255, 241, 214, 0.14);
  font-size: 22rpx;
  line-height: 50rpx;
  color: #fff2e0;
}

.paper-card {
  border-radius: 30rpx;
  background-color: #fffaf3;
  box-shadow: 0 12rpx 30rpx rgba(70, 35, 17, 0.08);
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-eyebrow {
  display: block;
  margin-bottom: 10rpx;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #997562;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2b1a18;
}

.section-meta {
  font-size: 22rpx;
  color: #8a6a57;
}

.field-block + .field-block {
  margin-top: 20rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #6d5449;
}

.copper-input,
.copper-textarea {
  width: 100%;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(170, 124, 76, 0.18);
  border-radius: 24rpx;
  background-color: #ffffff;
  font-size: 28rpx;
  color: #2c1a17;
}

.copper-textarea {
  min-height: 164rpx;
  line-height: 1.7;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #b5482a, #db9050);
  color: #fff4e8;
  font-size: 30rpx;
  font-weight: 700;
}

.primary-button[disabled] {
  opacity: 0.45;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(170, 124, 76, 0.22);
  background-color: rgba(255, 255, 255, 0.92);
  color: #7f4b30;
  font-size: 26rpx;
  font-weight: 600;
}

.chip-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 245, 230, 0.16);
  border: 1rpx solid rgba(255, 236, 214, 0.18);
  color: #fff2de;
  font-size: 24rpx;
}

.empty-card {
  padding: 46rpx 32rpx;
  text-align: center;
  border-radius: 28rpx;
  background-color: rgba(255, 255, 255, 0.92);
  color: #8b6f61;
}

.empty-card .empty-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #4d3028;
}

.bottom-nav {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  z-index: 26;
  padding: 10rpx;
  border-radius: 28rpx;
  background-color: rgba(255, 250, 243, 0.98);
  box-shadow: 0 14rpx 32rpx rgba(66, 33, 18, 0.14);
}

.bottom-nav-track {
  display: flex;
}

.bottom-nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  border-radius: 20rpx;
  color: #7d5c4a;
}

.bottom-nav-item.active {
  background: linear-gradient(135deg, #b94d2c, #d8934f);
  color: #fff6e8;
}

.bottom-nav-mark {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  opacity: 0.74;
}

.bottom-nav-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}
