page {
  min-height: 100%;
  background: #f6efe5;
  color: #241513;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea,
image,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  border: 0;
  background: transparent;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
}

.hero-shell {
  position: relative;
  overflow: hidden;
  margin-bottom: 28rpx;
  padding: 34rpx 32rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at top right, rgba(255, 214, 160, 0.46), transparent 38%),
    linear-gradient(145deg, #281311, #8d3f22 58%, #d98a4a 115%);
  color: #fff4e2;
  box-shadow: 0 24rpx 54rpx rgba(111, 47, 24, 0.24);
}

.hero-shell::before {
  content: "";
  position: absolute;
  top: -90rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border: 2rpx solid rgba(255, 241, 214, 0.18);
  border-radius: 50%;
}

.hero-kicker {
  display: block;
  margin-bottom: 14rpx;
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: rgba(255, 241, 214, 0.72);
  text-transform: uppercase;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.12;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 244, 226, 0.86);
}

.paper-card {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(247, 238, 228, 0.98));
  border: 1rpx solid rgba(170, 124, 76, 0.12);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 44rpx rgba(69, 34, 17, 0.08);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title text:first-child {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b1a18;
}

.section-title text:last-child {
  font-size: 22rpx;
  color: #8a6a57;
}

.field-block + .field-block {
  margin-top: 20rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #6d5449;
}

.copper-input,
.copper-textarea {
  width: 100%;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(170, 124, 76, 0.18);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  font-size: 28rpx;
  color: #2c1a17;
}

.copper-textarea {
  min-height: 164rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #b5482a, #db9050);
  color: #fff4e8;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 36rpx rgba(161, 73, 39, 0.24);
}

.primary-button[disabled] {
  opacity: 0.45;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(170, 124, 76, 0.24);
  background: rgba(255, 255, 255, 0.8);
  color: #7f4b30;
  font-size: 26rpx;
  font-weight: 600;
}

.chip-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 245, 230, 0.18);
  border: 1rpx solid rgba(255, 236, 214, 0.24);
  color: #fff2de;
  font-size: 24rpx;
}

.empty-card {
  padding: 44rpx 28rpx;
  text-align: center;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #8b6f61;
}

.empty-card .empty-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #4d3028;
}

.fixed-dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 32rpx;
  background: rgba(33, 17, 14, 0.92);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.18);
  backdrop-filter: blur(16rpx);
}

.fixed-dock .secondary-button {
  flex: 1;
  min-height: 84rpx;
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.12);
  color: #f4d4bc;
}

.fixed-dock .primary-button {
  flex: 1.4;
  min-height: 84rpx;
}
